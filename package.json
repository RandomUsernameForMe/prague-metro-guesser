{
  "name": "prague-metro-guesser",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test 'tests/*.test.mjs'",
    "build:stations": "node scripts/build-stations.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply metro-guesser --remote",
    "migrate:local": "wrangler d1 migrations apply metro-guesser --local",
    "smoke": "node scripts/duel-smoke.mjs && node scripts/duel-reconnect-smoke.mjs"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
